---
import "../../styles/global.css";
import JsonLd from "./json-ld.astro";
import Footer from "./footer.astro";
import { Font } from "astro:assets";

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = "en" } = Astro.props;
const hidden = Astro.url.pathname.startsWith("/hidden/");
---

<html lang={lang}>
  <head>
    <style is:inline>
      @layer base, components, utilities;
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hidden && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-jakarta-sans" preload />

    <script defer src="https://umami.rueberg.eu/script.js" data-website-id="bff03240-3d78-4b9c-a4dd-562567d7bf2f"
    ></script>
    <script defer src="https://umami.rueberg.eu/recorder.js" data-website-id="bff03240-3d78-4b9c-a4dd-562567d7bf2f"
    ></script>
  </head>
  <body>
    <slot name="menu" />
    <main class="content-grid">
      <slot />
    </main>
    <slot name="footer">
      <Footer />
    </slot>
  </body>
</html>
