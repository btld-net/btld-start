{
  "compilerOptions": {
    // See: https://nodejs.org/api/typescript.html#type-stripping

    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Custom

    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@btld/core": ["../btld-core/src/index.ts"]
    }
  }
}
